{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EAI Setup",
  "version": "0.1.0",
  "identifier": "com.enterpriseai.eai-setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EAI Setup",
        "width": 900,
        "height": 680,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "createUpdaterArtifacts": false
  }
}
